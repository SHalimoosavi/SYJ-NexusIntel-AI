# Copy to backend/.env for local development only. Never commit real values.
APP_ENV=development
DATABASE_URL=sqlite:///./nexusintel.db
JWT_SIGNING_KEYS={"local-dev-v1":"REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES"}
JWT_ACTIVE_KID=local-dev-v1
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=syj-nexusintel-ai
JWT_AUDIENCE=syj-nexusintel-ai-client
REDIS_URL=
CORS_ORIGINS=http://localhost:3000
TRUSTED_PROXY_HOSTS=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
